# syntax=docker/dockerfile:1.7
#
# Door 2 Digital — web-operator (Next.js 14 standalone).
# Per-app Dockerfile pattern (mirror per surface: web-org, partner-portal,
# marketing-studio, public-site).

ARG NODE_VERSION=20.10.0

FROM node:${NODE_VERSION}-alpine AS deps
RUN apk add --no-cache libc6-compat
WORKDIR /repo
RUN corepack enable && corepack prepare pnpm@9.12.0 --activate

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json tsconfig.base.json ./
COPY apps/web-operator/package.json apps/web-operator/
COPY apps/api/package.json apps/api/
COPY packages/shared-types/package.json packages/shared-types/
COPY packages/shared-utils/package.json packages/shared-utils/
COPY packages/ui-tokens/package.json packages/ui-tokens/
COPY packages/ui-web/package.json packages/ui-web/
COPY packages/api-client/package.json packages/api-client/
COPY packages/database/package.json packages/database/
COPY packages/integrations/package.json packages/integrations/
RUN pnpm fetch --frozen-lockfile
RUN pnpm install --frozen-lockfile --offline

FROM deps AS build
WORKDIR /repo
COPY apps/web-operator ./apps/web-operator
COPY packages ./packages
# @d2d/database re-exports the generated Prisma client — generate it from the
# API's schema before next build or the Prisma namespace collapses to the
# ungenerated stub (InputJsonValue/DbNull missing, every type downstream {}).
COPY apps/api/prisma ./apps/api/prisma
RUN pnpm --filter api exec prisma generate --schema apps/api/prisma/schema.prisma
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_WS_URL
ARG NEXT_PUBLIC_ENV=production
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}
ENV NEXT_PUBLIC_WS_URL=${NEXT_PUBLIC_WS_URL}
ENV NEXT_PUBLIC_ENV=${NEXT_PUBLIC_ENV}
ENV NEXT_TELEMETRY_DISABLED=1
RUN pnpm --filter web-operator build

FROM node:${NODE_VERSION}-alpine AS runner
RUN apk add --no-cache libc6-compat tini
WORKDIR /repo
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
# PORT CONTRACT (see docs/STAGING-DEPLOY.md): web-operator = 3000, api = 3010.
# Next's standalone server.js reads PORT from the environment at runtime.
# Railway injects its own PORT, which overrides this ENV default — so this
# value only governs local `docker run` and keeps the surface deterministic
# (web never defaults onto the API's 3010 again).
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

COPY --from=build /repo/apps/web-operator/public ./apps/web-operator/public
COPY --from=build /repo/apps/web-operator/.next/standalone ./
COPY --from=build /repo/apps/web-operator/.next/static ./apps/web-operator/.next/static

USER node
EXPOSE 3000

ENTRYPOINT ["/sbin/tini", "--"]
CMD ["node", "apps/web-operator/server.js"]
