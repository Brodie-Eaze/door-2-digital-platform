# web-operator environment variables
# Copy this file to .env.local and fill in real values for local development.
# NEVER commit .env.local — it is listed in .gitignore.

# ─── Database ────────────────────────────────────────────────────────────────
# Postgres connection string. Must match apps/api's DATABASE_URL so both
# surfaces share the same schema in local dev.
DATABASE_URL=postgresql://d2d:d2d@localhost:5432/d2d_dev?schema=public

# ─── PII / Audit ─────────────────────────────────────────────────────────────
# HMAC key for deterministic email/phone digest lookups. Must be ≥32 chars
# and match the value used by apps/api and seed scripts.
PII_SEARCH_KEY=dev-pii-search-key-must-be-at-least-32-chars

# HMAC key for the hash-chained AuditEvent log (ADR-0008). Must be ≥32 chars.
AUDIT_CHAIN_SECRET=dev-audit-chain-secret-must-be-at-least-32-chars

# ─── Session / JWT ───────────────────────────────────────────────────────────
# HS256 secret used to sign synthetic demo sessions (dev/preview only).
# Must match JWT_ACCESS_SECRET in apps/api.
# JWT_ACCESS_SECRET=dev-jwt-access-secret-must-be-at-least-32-chars

# ─── Demo login (DEV / PREVIEW ONLY) ─────────────────────────────────────────
# Set DEMO_MODE_ENABLED=true to enable the /api/session/demo route. It is
# hard-disabled when NODE_ENV=production regardless of this flag.
# DEMO_MODE_ENABLED=true

# DEMO_PASSWORDS_JSON — JSON object mapping demo account email → plaintext
# password. The /api/session/demo route checks this map; if a key is missing
# the corresponding demo login simply fails. Defaults to {} (all fail) when
# the variable is unset.
#
# Format: a JSON object, one key per demo account. Paste as a single line.
#
# Example:
#   DEMO_PASSWORDS_JSON={"brodie@door2digital.com":"replace-with-your-dev-pw","manager@hope-forward.com":"replace-with-your-dev-pw","manager@world-vision.org.au":"replace-with-your-dev-pw","manager@pestmax.com":"replace-with-your-dev-pw","manager@goldcoasthospital.org.au":"replace-with-your-dev-pw"}
#
# NEVER commit real password values. Use throwaway dev-only passwords locally.
# DEMO_PASSWORDS_JSON={"brodie@door2digital.com":"<dev-password>","manager@hope-forward.com":"<dev-password>"}

# ─── API URL ─────────────────────────────────────────────────────────────────
# When set, the web-operator BFF proxies auth to the real API instead of using
# the demo route. Leave unset in pure-frontend preview deployments.
# NEXT_PUBLIC_API_URL=http://localhost:3001
