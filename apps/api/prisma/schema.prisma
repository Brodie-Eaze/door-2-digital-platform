// =============================================================================
// Door 2 Digital — Prisma schema
// -----------------------------------------------------------------------------
// Hard rules:
//   - Every regulated table carries orgId, regionCode (immutable), brandCode.
//   - PII columns marked /// PII flow through services/pii-vault (envelope
//     encrypted, deterministic-SIV for searchable fields).
//   - Money is BigInt cents per ADR-0007.
//   - Soft delete only on regulated rows (status='archived'); never DELETE.
//   - Audit row written in same TX as every regulated mutation (ADR-0008).
//   - Region pinning at org creation IMMUTABLE — DB trigger raises on UPDATE.
// =============================================================================

generator client {
  provider = "prisma-client-js"
  // Note: previewFeatures = ["postgresqlExtensions"] is omitted in Phase 1.1
  // so that local dev (postgresql@16 without postgis) can run migrations.
  // CI/staging/prod restore the extension via a runtime SQL hook before
  // applying migrations.
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────────────────────────────────────────────────────────
// Enums
// ───────────────────────────────────────────────────────────────────────────

enum RegionCode {
  AU
  US
  SG
}

enum Vertical {
  charity
  commercial
}

enum OrgType {
  operator // D2D-internal entity
  client // Customer (e.g. Pilot-Charlie)
}

enum PlatformRole {
  super_admin
  org_admin
  manager
  knocker
  inside_sales
  accountant
  auditor
  viewer
}

enum KnockDisposition {
  no_answer
  not_interested
  callback
  do_not_knock
  appointment
  converted_donation
  converted_sale
  hostile
  invalid_address
}

enum LeadStatus {
  new
  contacted
  qualified
  appointment_set
  converted
  lost
  do_not_contact
}

enum ConversionType {
  donation_recurring
  donation_oneoff
  sale_commercial
}

enum AttributionSource {
  door
  inside_sales
  retargeting
  other
}

enum DonationFrequency {
  weekly
  fortnightly
  monthly
  annual
}

enum CommissionType {
  per_knock
  per_appointment
  per_conversion
  override
}

enum PayoutStatus {
  draft
  ready_to_pay
  instructed
  acknowledged
  archived
}

enum ConsentChannel {
  sms
  email
  phone
  postal
  door
}

enum WebhookStatus {
  pending
  delivered
  failed
  dlq
}

enum PaymentProvider {
  micamp
  stripe_au
  stripe_sg
}

enum SolicitorStatus {
  pending
  submitted
  approved
  expired
  rejected
}

enum SsoProvider {
  okta
  azuread
  auth0
  google_workspace
  generic_saml
}

enum KnockerShiftStatus {
  scheduled
  active
  lunch
  missed
  completed
}

// ───────────────────────────────────────────────────────────────────────────
// Org, BrandKit, Billing, SSO
// ───────────────────────────────────────────────────────────────────────────

model Org {
  id          String     @id // ULID prefixed: org_*
  // URL-safe slug — primary external identifier used in web URLs and Route
  // Handler params. Optional in the schema so existing rows survive the
  // additive migration; the route handler 404s if a slug is missing for an
  // org the UI tries to read. New orgs MUST receive a slug at create time.
  slug        String?    @unique
  legalName   String
  tradingName String
  vertical    Vertical
  type        OrgType
  regionCode  RegionCode // IMMUTABLE — DB CHECK + trigger enforce
  brandCode   String     @default("d2d")
  abnAcnUen   String? // AU ABN/ACN, SG UEN, US EIN — region-validated in service layer
  status      String     @default("active") // active | archived

  aiBudgetCents       BigInt  @default(0)
  aiRetargetingOptOut Boolean @default(false)

  // Enterprise tenant flags (Pilot-Charlie)
  dedicatedDb Boolean      @default(false)
  ssoProvider SsoProvider?
  ssoMetadata Json?

  createdAt  DateTime  @default(now())
  archivedAt DateTime?

  users                      User[]
  territories                Territory[]
  campaigns                  Campaign[]
  serviceOfferings           ServiceOffering[]
  leads                      Lead[]
  knockSessions              KnockSession[]
  knocks                     Knock[]
  conversions                Conversion[]
  commissionPlans            CommissionPlan[]
  commissions                Commission[]
  payoutBatches              PayoutBatch[]
  adAccounts                 AdAccount[]
  creatives                  Creative[]
  adCampaigns                AdCampaign[]
  webhookEndpoints           WebhookEndpoint[]
  apiKeys                    ApiKey[]
  brandKit                   BrandKit?
  billing                    OrgBilling?
  ssoConfiguration           SsoConfiguration?
  paidSolicitorRegistrations PaidSolicitorRegistration[]
  providerConnections        ProviderConnection[]
  contentGenerationJobs      ContentGenerationJob[]
  providerWebhookEvents      ProviderWebhookEvent[]
  knockerShifts              KnockerShift[]
  knockPhotos                KnockPhoto[]
  voiceRecordings            VoiceRecording[]
  propensityScores           PropensityScore[]
  analyticsEvents            AnalyticsEvent[]
  invoices                   Invoice[]

  @@index([regionCode, status])
  @@index([type, status])
}

model BrandKit {
  id               String   @id
  orgId            String   @unique
  org              Org      @relation(fields: [orgId], references: [id])
  displayName      String
  logoLightKey     String? // S3 key (KMS encrypted)
  logoDarkKey      String?
  iconKey          String?
  faviconKey       String?
  primaryColor     String   @default("#0F172A") // hex ink
  accentColor      String   @default("#3B82F6") // hex accent
  customDomain     String?  @unique
  appBundleId      String? // iOS — for white-label Xcode builds
  appPackageName   String? // Android (Phase 2+)
  supportEmail     String?
  supportPhone     String?
  privacyPolicyUrl String?
  termsUrl         String?
  updatedAt        DateTime @updatedAt
}

model OrgBilling {
  id                      String   @id
  orgId                   String   @unique
  org                     Org      @relation(fields: [orgId], references: [id])
  // Pilot-Charlie defaults: $2500/mo + 5/10/15%
  platformFeeMonthlyCents BigInt   @default(250000)
  doorRakePercent         Decimal  @default(15.00) @db.Decimal(5, 2)
  insideSalesRakePercent  Decimal  @default(10.00) @db.Decimal(5, 2)
  retargetingRakePercent  Decimal  @default(5.00) @db.Decimal(5, 2)
  billingDay              Int      @default(1) // day of month (1-28)
  currency                String   @default("USD")
  micampMerchantId        String? // ISO board reference
  stripeCustomerId        String? // for AU/SG
  updatedAt               DateTime @updatedAt
}

model SsoConfiguration {
  id                   String      @id
  orgId                String      @unique
  org                  Org         @relation(fields: [orgId], references: [id])
  provider             SsoProvider
  entityId             String
  ssoUrl               String
  certificateKey       String /// PII — S3 KMS
  attributeMappingJson Json
  status               String      @default("pending") // pending | active | revoked
  lastValidatedAt      DateTime?
  createdAt            DateTime    @default(now())
}

// ───────────────────────────────────────────────────────────────────────────
// User
// ───────────────────────────────────────────────────────────────────────────

model User {
  id               String       @id // usr_*
  orgId            String
  org              Org          @relation(fields: [orgId], references: [id])
  email            String /// PII (vaulted ciphertext column)
  emailDigest      String       @unique // deterministic-SIV for unique lookup
  phone            String? /// PII
  phoneDigest      String?      @unique
  givenName        String /// PII
  familyName       String /// PII
  role             PlatformRole
  managerId        String? // org-hierarchy parent
  manager          User?        @relation("ReportsTo", fields: [managerId], references: [id])
  reports          User[]       @relation("ReportsTo")
  status           String       @default("active")
  regionCode       RegionCode
  brandCode        String       @default("d2d")
  cognitoSub       String?      @unique // bridge to Cognito user pool
  webauthnRequired Boolean      @default(false)
  lastLoginAt      DateTime?
  createdAt        DateTime     @default(now())

  knockSessions        KnockSession[]
  knocks               Knock[]
  leadActivities       LeadActivity[]
  commissions          Commission[]
  assignedLeads        Lead[]                @relation("AssignedTo")
  knockerConversions   Conversion[]          @relation("KnockerAttribution")
  closerConversions    Conversion[]          @relation("CloserAttribution")
  territoryAssignments TerritoryAssignment[]
  credential           UserCredential?
  refreshTokens        RefreshToken[]
  knockerShifts        KnockerShift[]
  knockPhotos          KnockPhoto[]
  voiceRecordings      VoiceRecording[]

  @@index([orgId, role])
  @@index([orgId, managerId])
  @@index([orgId, status])
}

// ───────────────────────────────────────────────────────────────────────────
// Territory (PostGIS polygons + heat overlays)
// ───────────────────────────────────────────────────────────────────────────

model Territory {
  id           String     @id // ter_*
  orgId        String
  org          Org        @relation(fields: [orgId], references: [id])
  regionCode   RegionCode
  brandCode    String     @default("d2d")
  name         String
  vertical     Vertical
  // PostGIS geometry — Phase 1.1 placeholder as TEXT until PostGIS lands
  // on the dev DB. A follow-up migration enables postgis + ALTERs these
  // to geography(Polygon, 4326) / geography(Point, 4326).
  polygon      String?
  centroid     String?
  // Area model: a manager defines the canvass area as EITHER a drawn polygon
  // ('polygon') OR a center+radius circle ('radius'). The app renders whichever
  // is set — it pushes the AREA to canvass, never per-house targets. Radius uses
  // `centroid` as the center ("lng lat") + radiusMeters.
  areaType     String     @default("polygon") // "polygon" | "radius"
  radiusMeters Int? // set when areaType = 'radius'
  s2CellIds    String[]   @default([]) // level-13 covering for fast lookup
  campaignId   String?
  campaign     Campaign?  @relation(fields: [campaignId], references: [id])
  status       String     @default("active")
  metadata     Json       @default("{}") // SEIFA decile, ACS median income, etc.
  createdAt    DateTime   @default(now())

  assignments   TerritoryAssignment[]
  knockSessions KnockSession[]
  knocks        Knock[]
  knockerShifts KnockerShift[]

  @@index([orgId, status])
  @@index([campaignId])
}

model TerritoryAssignment {
  id          String    @id
  territoryId String
  territory   Territory @relation(fields: [territoryId], references: [id])
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  assignedAt  DateTime  @default(now())
  expiresAt   DateTime?

  @@unique([territoryId, userId, assignedAt])
}

// ───────────────────────────────────────────────────────────────────────────
// Campaign (per-vertical, per-client, drives state-clearance gates)
// ───────────────────────────────────────────────────────────────────────────

model Campaign {
  id                        String     @id // cmp_*
  orgId                     String
  org                       Org        @relation(fields: [orgId], references: [id])
  regionCode                RegionCode
  brandCode                 String     @default("d2d")
  name                      String
  vertical                  Vertical
  // For charity campaigns: link to the registered charity entity
  charityRegistrationNumber String?
  pitchScriptMd             String? /// optional markdown pitch script
  budgetCents               BigInt     @default(0)
  startDate                 DateTime?
  endDate                   DateTime?
  status                    String     @default("draft") // draft | active | paused | archived
  createdAt                 DateTime   @default(now())

  territories     Territory[]
  leads           Lead[]
  conversions     Conversion[]
  stateClearances CampaignStateClearance[]
  adCampaigns     AdCampaign[]

  @@index([orgId, status])
}

// ───────────────────────────────────────────────────────────────────────────
// Paid solicitor registration & state clearance
// ───────────────────────────────────────────────────────────────────────────

model PaidSolicitorRegistration {
  id                 String          @id // psr_*
  regionCode         RegionCode // currently always US — extend if AU state filings needed
  state              String // 2-letter (US: 'CA', 'NY', 'TX', etc.)
  entityOrgId        String // D2D operator org doing the soliciting
  entity             Org             @relation(fields: [entityOrgId], references: [id])
  clientOrgId        String // The charity org being solicited for
  status             SolicitorStatus @default(pending)
  filedAt            DateTime?
  approvedAt         DateTime?
  expiresAt          DateTime?
  bondAmountCents    BigInt          @default(0)
  registrationNumber String?
  evidenceKey        String? // S3 path to filing artifact
  notes              String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  clearances CampaignStateClearance[]

  @@unique([entityOrgId, clientOrgId, state, regionCode])
  @@index([state, status])
}

model CampaignStateClearance {
  id                          String                    @id
  campaignId                  String
  campaign                    Campaign                  @relation(fields: [campaignId], references: [id])
  state                       String
  clearedAt                   DateTime                  @default(now())
  paidSolicitorRegistrationId String
  registration                PaidSolicitorRegistration @relation(fields: [paidSolicitorRegistrationId], references: [id])

  @@unique([campaignId, state])
  @@index([state])
}

// ───────────────────────────────────────────────────────────────────────────
// Address, KnockSession, Knock, Lead
// ───────────────────────────────────────────────────────────────────────────

model Address {
  id          String     @id // adr_*
  regionCode  RegionCode
  formatted   String
  unit        String?
  street      String
  locality    String
  region      String // state / territory
  postcode    String
  countryCode String // ISO 3166-1 alpha-2
  // PostGIS geometry — TEXT placeholder until postgis is on the dev DB.
  geo         String?
  s2CellId    String?
  hashKey     String     @unique // SHA-256 of normalised fields
  createdAt   DateTime   @default(now())

  knocks Knock[]
  leads  Lead[]

  @@index([regionCode, locality])
  @@index([s2CellId])
}

model KnockSession {
  id               String     @id // sess_*
  orgId            String
  org              Org        @relation(fields: [orgId], references: [id])
  userId           String
  user             User       @relation(fields: [userId], references: [id])
  territoryId      String
  territory        Territory  @relation(fields: [territoryId], references: [id])
  regionCode       RegionCode
  startedAt        DateTime
  endedAt          DateTime?
  // PostGIS geometry — TEXT placeholder until postgis is on the dev DB.
  startGeo         String?
  deviceId         String
  appVersion       String?
  osVersion        String?
  attestationToken String? // App Attest (iOS), Play Integrity (Android)

  knocks Knock[]

  @@index([userId, startedAt])
}

model Knock {
  id               String           @id // knk_*
  sessionId        String
  session          KnockSession     @relation(fields: [sessionId], references: [id])
  orgId            String
  org              Org              @relation(fields: [orgId], references: [id])
  userId           String
  user             User             @relation(fields: [userId], references: [id])
  territoryId      String
  territory        Territory        @relation(fields: [territoryId], references: [id])
  addressId        String
  address          Address          @relation(fields: [addressId], references: [id])
  regionCode       RegionCode
  brandCode        String           @default("d2d")
  disposition      KnockDisposition
  // PostGIS geometry — TEXT placeholder until postgis is on the dev DB.
  geo              String?
  capturedAt       DateTime // device clock
  serverReceivedAt DateTime         @default(now())
  clientOffsetMs   Int? // fraud signal: device clock skew
  photoKey         String? // S3 KMS encrypted
  signatureKey     String?
  notes            String? /// PII (optional free-text)
  leadId           String?
  lead             Lead?            @relation(fields: [leadId], references: [id])
  syncBatchId      String? // offline reconciliation
  idempotencyKey   String           @unique

  conversions Conversion[]

  @@index([orgId, capturedAt])
  @@index([addressId])
  @@index([userId, capturedAt])
}

model Lead {
  id            String     @id // lead_*
  orgId         String
  org           Org        @relation(fields: [orgId], references: [id])
  regionCode    RegionCode
  brandCode     String     @default("d2d")
  sourceKnockId String?
  addressId     String?
  address       Address?   @relation(fields: [addressId], references: [id])
  status        LeadStatus @default(new)
  assignedToId  String? // inside-sales user
  assignedTo    User?      @relation("AssignedTo", fields: [assignedToId], references: [id])
  vertical      Vertical
  campaignId    String?
  campaign      Campaign?  @relation(fields: [campaignId], references: [id])
  givenName     String /// PII (legacy plaintext — name kept readable for routing UIs)
  familyName    String /// PII (legacy plaintext)
  email         String? /// PII (legacy plaintext — superseded by emailVault when present)
  emailDigest   String? // HMAC-SHA256 search digest
  phone         String? /// PII (legacy plaintext — superseded by phoneVault when present)
  phoneDigest   String? // HMAC-SHA256 search digest
  // PII vault — Agent 15: envelope-encrypted blobs binding ciphertext to
  // (rowType, rowId) via AAD. Legacy plaintext columns above retained for
  // backwards compat; pii-vault unmask is the only path to plaintext.
  emailVault    Json?
  phoneVault    Json?
  notesVault    Json?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  knocks         Knock[]
  activities     LeadActivity[]
  conversions    Conversion[]
  consentRecords ConsentRecord[]

  @@index([orgId, status, assignedToId])
  @@index([phoneDigest])
  @@index([emailDigest])
}

model LeadActivity {
  id        String   @id
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id])
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  type      String // call_outbound | call_inbound | sms | email | note | sequence_step
  outcome   String?
  payload   Json     @default("{}")
  createdAt DateTime @default(now())

  @@index([leadId, createdAt])
}

// ───────────────────────────────────────────────────────────────────────────
// Conversion (polymorphic: Donation | Sale) + AttributionSource → billing
// ───────────────────────────────────────────────────────────────────────────

model Conversion {
  id                     String            @id // cnv_*
  orgId                  String
  org                    Org               @relation(fields: [orgId], references: [id])
  regionCode             RegionCode
  brandCode              String            @default("d2d")
  leadId                 String
  lead                   Lead              @relation(fields: [leadId], references: [id])
  knockId                String?
  knock                  Knock?            @relation(fields: [knockId], references: [id])
  campaignId             String?
  campaign               Campaign?         @relation(fields: [campaignId], references: [id])
  knockerId              String? // door attribution
  knocker                User?             @relation("KnockerAttribution", fields: [knockerId], references: [id])
  closerId               String? // inside-sales who closed
  closer                 User?             @relation("CloserAttribution", fields: [closerId], references: [id])
  type                   ConversionType
  attributionSource      AttributionSource // drives billing rake bucket
  retargetingCampaignId  String? // FK to AdCampaign if attribution=retargeting
  amountCents            BigInt
  currency               String            @default("USD")
  signedAt               DateTime
  signatureKey           String? // S3 KMS
  paymentProvider        PaymentProvider
  paymentExternalId      String? // MiCamp transaction id / Stripe charge id
  processorResidualCents BigInt            @default(0) // computed for MiCamp ISO
  d2dRakeCents           BigInt            @default(0) // D2D's take per attribution bucket
  idempotencyKey         String            @unique

  donation Donation?
  sale     Sale?

  @@index([orgId, signedAt])
  @@index([campaignId, attributionSource])
  @@index([knockerId, signedAt])
}

model Donation {
  id                        String             @id // don_*
  conversionId              String             @unique
  conversion                Conversion         @relation(fields: [conversionId], references: [id])
  donorEmail                String /// PII
  amountCents               BigInt
  currency                  String
  frequency                 DonationFrequency? // null = one-off
  paymentMethodToken        String // MiCamp token or Stripe pm_*
  externalSubscriptionId    String? // MiCamp recurring id or Stripe sub_*
  status                    String             @default("active")
  // Receipt fields (IRS for US, ACNC for AU, COC for SG)
  receiptNumber             String?
  deductibleGiftRecipientNo String? // AU DGR
  einOrEquivalent           String? // US 501(c)(3) EIN or equivalent
  startedAt                 DateTime
  cancelledAt               DateTime?

  @@index([externalSubscriptionId])
}

model Sale {
  id                 String     @id // sal_*
  conversionId       String     @unique
  conversion         Conversion @relation(fields: [conversionId], references: [id])
  productSku         String
  installerOrgId     String?
  scheduledInstallAt DateTime?
  status             String     @default("pending_install") // pending_install | installed | cancelled
}

// ───────────────────────────────────────────────────────────────────────────
// Commission & Payout
// ───────────────────────────────────────────────────────────────────────────

model CommissionPlan {
  id            String    @id // plan_*
  orgId         String
  org           Org       @relation(fields: [orgId], references: [id])
  name          String
  vertical      Vertical
  rules         Json // declarative DSL versioned in @d2d/shared-types
  rulesVersion  String    @default("v0.1")
  effectiveFrom DateTime
  effectiveTo   DateTime?

  commissions Commission[]
}

model Commission {
  id            String         @id // com_*
  orgId         String
  org           Org            @relation(fields: [orgId], references: [id])
  userId        String
  user          User           @relation(fields: [userId], references: [id])
  planId        String
  plan          CommissionPlan @relation(fields: [planId], references: [id])
  type          CommissionType
  conversionId  String?
  knockId       String?
  amountCents   BigInt
  currency      String
  periodStart   DateTime
  periodEnd     DateTime
  payoutBatchId String?
  payoutBatch   PayoutBatch?   @relation(fields: [payoutBatchId], references: [id])
  status        String         @default("accrued") // accrued | included | paid

  @@index([userId, periodStart])
  @@index([payoutBatchId])
}

model PayoutBatch {
  id                 String       @id // pay_*
  orgId              String
  org                Org          @relation(fields: [orgId], references: [id])
  regionCode         RegionCode
  periodStart        DateTime
  periodEnd          DateTime
  status             PayoutStatus
  totalCents         BigInt
  currency           String
  instructionFileKey String? // S3 path to ABA/NACHA/CSV/PayNow instruction file
  instructedAt       DateTime? // when ops downloaded + sent the file
  acknowledgedAt     DateTime?

  commissions Commission[]

  @@index([orgId, status])
}

// ───────────────────────────────────────────────────────────────────────────
// Billing — Invoice + line items (Phase 1.3)
// ───────────────────────────────────────────────────────────────────────────

model Invoice {
  id         String     @id // inv_*
  orgId      String
  org        Org        @relation(fields: [orgId], references: [id])
  regionCode RegionCode

  periodStart DateTime
  periodEnd   DateTime

  // Status: draft → sent → paid | void
  status String @default("draft") // draft | sent | paid | void

  // Computed totals (sum of lineItems)
  platformFeeCents      BigInt @default(0)
  doorRakeCents         BigInt @default(0)
  insideSalesRakeCents  BigInt @default(0)
  retargetingRakeCents  BigInt @default(0)
  additionalCents       BigInt @default(0) // overages, credits, one-offs
  totalCents            BigInt
  currency              String @default("USD")

  // Idempotency — one invoice per (org, period) pair
  idempotencyKey String @unique // "inv-${orgId}-${periodStart.slice(0,7)}"

  sentAt DateTime?
  paidAt DateTime?

  lineItems InvoiceLineItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId, periodStart])
  @@index([orgId, status])
}

model InvoiceLineItem {
  id        String  @id // ili_*
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id])

  // kind drives label + display order
  kind        String // platform_fee | door_rake | inside_sales_rake | retargeting_rake | overage | credit | one_off
  description String
  amountCents BigInt
  currency    String @default("USD")

  // For rake lines — how many conversions contributed
  conversionCount Int @default(0)

  @@index([invoiceId])
}

// ───────────────────────────────────────────────────────────────────────────
// Marketing (AdAccount, Creative, AdCampaign — Phase 3)
// ───────────────────────────────────────────────────────────────────────────

model AdAccount {
  id            String   @id
  orgId         String
  org           Org      @relation(fields: [orgId], references: [id])
  provider      String // meta | google | tiktok | youtube
  externalId    String
  tokenVaultRef String /// PII — pointer into PII vault
  status        String   @default("active")
  createdAt     DateTime @default(now())

  campaigns AdCampaign[]
}

model Creative {
  id               String    @id // crv_*
  orgId            String
  org              Org       @relation(fields: [orgId], references: [id])
  type             String // copy | image | video
  assetKey         String // S3 KMS
  prompt           String?
  model            String? // e.g. claude-3-5-sonnet, flux-1.1-pro, runway-gen-3
  modelVersion     String?
  costCents        BigInt    @default(0)
  safetyScanResult Json      @default("{}")
  c2paManifestId   String?
  approvedAt       DateTime?
  approvedBy       String?
  createdAt        DateTime  @default(now())

  adCampaigns AdCampaign[]
}

model AdCampaign {
  id                 String    @id
  orgId              String
  org                Org       @relation(fields: [orgId], references: [id])
  campaignId         String? // link back to D2D Campaign
  campaign           Campaign? @relation(fields: [campaignId], references: [id])
  adAccountId        String
  adAccount          AdAccount @relation(fields: [adAccountId], references: [id])
  provider           String
  objective          String
  audienceJson       Json
  budgetCents        BigInt
  status             String    @default("draft")
  externalCampaignId String?
  startedAt          DateTime?
  endedAt            DateTime?
  createdAt          DateTime  @default(now())

  creatives Creative[]
}

// ───────────────────────────────────────────────────────────────────────────
// Compliance — Do-Not-Knock / Do-Not-Call / Consent
// ───────────────────────────────────────────────────────────────────────────

model DoNotKnock {
  id         String     @id
  regionCode RegionCode
  addressId  String
  source     String // FTC | state list name | CHOICE DNK
  loadedAt   DateTime   @default(now())

  @@unique([regionCode, addressId])
}

model DoNotCall {
  id          String     @id
  regionCode  RegionCode
  phoneDigest String // HMAC-SHA256 of normalised E.164
  source      String
  loadedAt    DateTime   @default(now())

  @@unique([regionCode, phoneDigest])
}

model ConsentRecord {
  id         String         @id
  leadId     String?
  lead       Lead?          @relation(fields: [leadId], references: [id])
  channel    ConsentChannel
  granted    Boolean
  text       String // exact wording shown
  capturedAt DateTime
  ip         String?
  // PostGIS geometry — TEXT placeholder until postgis is on the dev DB.
  geo        String?
  proofKey   String? // signature/recording in S3 KMS
  expiresAt  DateTime?
  revokedAt  DateTime?

  @@index([leadId, capturedAt])
}

// ───────────────────────────────────────────────────────────────────────────
// Audit (hash-chained outbox — ADR-0008)
// ───────────────────────────────────────────────────────────────────────────

model AuditEvent {
  id            BigInt     @id @default(autoincrement())
  ulid          String     @unique // aud_* (preferred external ID)
  orgId         String?
  regionCode    RegionCode
  actorUserId   String?
  action        String // e.g. "knock.created", "pii.unmasked", "payout.instructed"
  resourceType  String
  resourceId    String
  beforeJson    Json?
  afterJson     Json?
  metadata      Json       @default("{}")
  prevHash      String // hex
  rowHash       String // HMAC-SHA256(prevHash || canonical(rest))
  occurredAt    DateTime   @default(now())
  shippedToS3At DateTime?

  @@index([orgId, occurredAt])
  @@index([resourceType, resourceId])
  @@index([occurredAt])
  // P-002: chain-head lookup index. AuditService.recordEvent and
  // verifyChain both run ORDER BY id DESC LIMIT 1 scoped by orgId (+
  // regionCode for platform-level rows). Without a covering composite
  // index this degrades to a Seq Scan as the table grows.
  @@index([orgId, regionCode, id(sort: Desc)])
}

// ───────────────────────────────────────────────────────────────────────────
// Public API surface — ApiKey, WebhookEndpoint, WebhookDelivery, IdempotencyRecord
// ───────────────────────────────────────────────────────────────────────────

model ApiKey {
  id         String    @id // key_*
  orgId      String
  org        Org       @relation(fields: [orgId], references: [id])
  prefix     String    @unique // d2d_live_xxxxxx
  secretHash String // bcrypt or argon2 of the secret
  scopes     String[] // e.g. knock:read, conversion:write
  label      String?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?
}

model WebhookEndpoint {
  id           String   @id // whk_*
  orgId        String
  org          Org      @relation(fields: [orgId], references: [id])
  url          String
  secretCipher String /// PII vault (HMAC signing secret)
  eventTypes   String[]
  status       String   @default("active") // active | paused | archived
  createdAt    DateTime @default(now())

  deliveries WebhookDelivery[]
}

model WebhookDelivery {
  id            String          @id
  endpointId    String
  endpoint      WebhookEndpoint @relation(fields: [endpointId], references: [id])
  eventId       String
  status        WebhookStatus
  attempts      Int             @default(0)
  lastError     String?
  nextAttemptAt DateTime?
  payloadKey    String // S3 key
  createdAt     DateTime        @default(now())
  deliveredAt   DateTime?

  @@index([endpointId, status])
  @@index([status, nextAttemptAt])
}

model IdempotencyRecord {
  key             String   @id
  orgId           String
  method          String
  path            String
  bodyHash        String
  responseStatus  Int
  responseBodyKey String // S3 KMS (or inline JSON for small payloads)
  responseBody    Json? // inline body for dev/small payloads — S3 path used in prod
  expiresAt       DateTime

  @@index([expiresAt])
}

// ───────────────────────────────────────────────────────────────────────────
// Auth — RefreshToken (rotating) + Invite (pending-user activation)
// ───────────────────────────────────────────────────────────────────────────

model UserCredential {
  userId          String    @id
  user            User      @relation(fields: [userId], references: [id])
  // scrypt salt:hash hex pair (32-byte salt, 64-byte derived key)
  passwordHash    String
  // Optional invite token (HMAC of opaque token), present while user is pending acceptance
  inviteTokenHash String?   @unique
  inviteExpiresAt DateTime?
  updatedAt       DateTime  @updatedAt
}

model RefreshToken {
  id          String    @id // rft_*
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  orgId       String
  // SHA-256 of the opaque refresh token (we never store the plaintext)
  tokenHash   String    @unique
  expiresAt   DateTime
  revokedAt   DateTime?
  rotatedToId String? // ID of the replacement token if rotated
  userAgent   String?
  ip          String?
  createdAt   DateTime  @default(now())

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

// ───────────────────────────────────────────────────────────────────────────
// PII Vault — two-person JIT unmask requests (Agent 15)
// ───────────────────────────────────────────────────────────────────────────

model PiiUnmaskRequest {
  id             String     @id // pur_*
  orgId          String
  regionCode     RegionCode
  requesterId    String
  approverId     String?
  rowType        String // Lead | Donation | Sale | Conversion
  rowId          String
  fields         String[] // email | phone | address | fullName | paymentLast4
  justification  String
  status         String     @default("pending") // pending | approved | rejected | revealed | expired
  grantTokenHash String?
  grantExpiresAt DateTime?
  revealedAt     DateTime?
  rejectedAt     DateTime?
  rejectedReason String?
  createdAt      DateTime   @default(now())

  @@index([orgId, status])
  @@index([rowType, rowId])
}

// ───────────────────────────────────────────────────────────────────────────
// Notification Log — Agent 15 (sms / email / push channels)
// ───────────────────────────────────────────────────────────────────────────

model NotificationLog {
  id                 String     @id // nlg_*
  orgId              String
  regionCode         RegionCode
  channel            String // sms | email | push
  recipientHash      String // HMAC-SHA256 of normalised recipient — never plaintext
  subject            String?
  bodyPreview        String // up to 200 chars (no PII bleed)
  fromBrand          String?
  status             String     @default("queued") // queued | sent | failed | bounced
  providerExternalId String?
  providerError      String?
  payload            Json       @default("{}")
  createdAt          DateTime   @default(now())
  sentAt             DateTime?

  @@index([orgId, channel, status])
  @@index([orgId, createdAt])
}

// ───────────────────────────────────────────────────────────────────────────
// Marketing Studio — provider connections, generation jobs, inbound events
// (Agent 16). One ProviderConnection per (orgId, kind); credentials sealed
// in PII vault JSON. ContentGenerationJob captures every adapter dispatch
// (sync or async) and links to the connection used. ProviderWebhookEvent
// stores HMAC-verified inbound events with replay protection.
// ───────────────────────────────────────────────────────────────────────────

model ProviderConnection {
  id                String    @id // prc_*
  orgId             String
  org               Org       @relation(fields: [orgId], references: [id])
  kind              String // ProviderKind enum value (meta_marketing, claude_copy, etc.)
  displayName       String
  mode              String // 'sandbox' | 'production'
  status            String // 'connected' | 'error' | 'disconnected'
  /// PII — encrypted via PII Vault. JSONB.
  credentialsVault  Json?
  accountLabel      String?
  accountId         String?
  /// PII — webhook signing secret (stored as bcrypt-style hash; ProviderConnection
  /// returns plaintext once on connect, then only the hash is kept)
  webhookSecretHash String?
  lastPingAt        DateTime?
  lastPingStatus    String? // 'ok' | 'fail'
  lastPingError     String?
  connectedAt       DateTime  @default(now())
  disconnectedAt    DateTime?

  contentGenerationJobs ContentGenerationJob[]
  providerWebhookEvents ProviderWebhookEvent[]

  @@unique([orgId, kind])
  @@index([orgId, status])
}

model ContentGenerationJob {
  id                   String             @id // cgj_*
  orgId                String
  org                  Org                @relation(fields: [orgId], references: [id])
  providerConnectionId String
  providerConnection   ProviderConnection @relation(fields: [providerConnectionId], references: [id])
  providerKind         String
  capability           String // ProviderCapability enum value
  status               String // 'pending' | 'running' | 'ready' | 'failed' | 'cancelled'
  /// Input JSON sent to the adapter.
  inputJson            Json
  /// Output JSON returned by the adapter (or error).
  outputJson           Json?
  costCents            BigInt             @default(0)
  modelId              String?
  promptHash           String?
  safetyScanResult     String? // 'pass' | 'fail' | 'review'
  c2paManifestId       String?
  externalJobId        String? // for async providers (Runway, Higgsfield, HeyGen)
  createdById          String
  createdAt            DateTime           @default(now())
  completedAt          DateTime?
  errorCode            String?
  errorMessage         String?

  @@index([orgId, status, createdAt(sort: Desc)])
  @@index([orgId, providerKind, createdAt(sort: Desc)])
  @@index([externalJobId])
}

model ProviderWebhookEvent {
  id                   String              @id // pwe_*
  orgId                String
  org                  Org                 @relation(fields: [orgId], references: [id])
  providerConnectionId String?
  providerConnection   ProviderConnection? @relation(fields: [providerConnectionId], references: [id])
  providerKind         String
  eventType            String
  externalId           String
  occurredAt           DateTime
  /// Verified inbound payload.
  payloadJson          Json
  verifiedSignature    Boolean
  receivedAt           DateTime            @default(now())
  processedAt          DateTime?

  @@unique([providerKind, externalId])
  @@index([orgId, providerKind, receivedAt(sort: Desc)])
}

// ───────────────────────────────────────────────────────────────────────────
// Roster scheduling — KnockerShift
//
// Stores the weekly roster schedule for each knocker. Persisted via the
// web-operator BFF (Next.js /api/shifts). The weekStart field is the ISO
// date string of the Monday for that week (e.g. "2026-06-09"), which lets
// the roster page fetch shifts for any week offset without date arithmetic
// on the server side.
// ───────────────────────────────────────────────────────────────────────────

model KnockerShift {
  id           String             @id // ksft_*
  orgId        String
  org          Org                @relation(fields: [orgId], references: [id])
  weekStart    String // ISO date of the Monday, e.g. "2026-06-09"
  repInitials  String // e.g. "JM"
  repName      String // e.g. "Jordan Mosley"
  account      String // e.g. "Hope Forward"
  day          Int // 0 = Mon … 6 = Sun
  start        String // "HH:MM"
  end          String // "HH:MM"
  territory    String
  lunch        String? // "HH:MM-HH:MM" or null
  status       KnockerShiftStatus @default(scheduled)
  // Knocker iOS link — the rep + territory this shift is rostered to, so the
  // native app can query "my shifts" (KnockerShift where userId = me) and open
  // the map straight onto the rostered territory. Nullable for legacy rows /
  // unassigned slots created before the field-app integration.
  userId       String?
  user         User?              @relation(fields: [userId], references: [id])
  territoryId  String?
  territoryRef Territory?         @relation(fields: [territoryId], references: [id])
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([orgId, weekStart])
  @@index([userId, weekStart])
}

// ───────────────────────────────────────────────────────────────────────────
// ServiceOffering — the per-tenant catalog of things a knocker signs a
// customer up to (charity giving tiers, or commercial product plans). Defined
// per Org in the Door 2 Digital Platform; Knocker iOS fetches the active set
// via GET /v1/catalog so each charity/business runs its own offerings.
// ───────────────────────────────────────────────────────────────────────────

model ServiceOffering {
  id          String     @id // svo_*
  orgId       String
  org         Org        @relation(fields: [orgId], references: [id])
  regionCode  RegionCode
  brandCode   String     @default("d2d")
  campaignId  String? // soft reference to a Campaign (no FK — catalog is org-scoped)
  name        String // "Hope Plus"
  blurb       String     @default("") // "Clean water for a family"
  amountCents BigInt // 4000 = $40
  frequency   String // "monthly" | "weekly" | "once" (matches field-signup contract)
  vertical    Vertical
  highlighted Boolean    @default(false) // suggested / most-popular tier
  active      Boolean    @default(true)
  sortOrder   Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([orgId, active, sortOrder])
}

// ═══════════════════════════════════════════════════════════════════════════
// DATA LAYER — D2D is a data company. Every field action is captured + held +
// tied to org/user, in shapes a data-science / ML team can plug straight into.
// ═══════════════════════════════════════════════════════════════════════════

// A property photo captured at a knock. Stored server-side (S3 in prod; local
// blob dir in dev). `knockId` links to the server Knock once the batch syncs;
// `clientKnockId` is the app's UUID for reconciliation (the Knock arrives on a
// separate path). ML annotates `mlLabels` later (house type, condition, …).
model KnockPhoto {
  id            String     @id // kph_*
  orgId         String
  org           Org        @relation(fields: [orgId], references: [id])
  userId        String
  user          User       @relation(fields: [userId], references: [id])
  regionCode    RegionCode
  knockId       String? // server Knock id once reconciled
  clientKnockId String? // app-side knock UUID
  storageKey    String // S3 object key / local blob path
  contentType   String     @default("image/jpeg")
  byteSize      Int?
  capturedAt    DateTime
  latitude      Float?
  longitude     Float?
  addressLine   String? /// PII — captured address context
  mlLabels      Json? // data-science annotations (written by the ML pipeline)
  mlProcessedAt DateTime?
  createdAt     DateTime   @default(now())

  @@index([orgId, capturedAt])
  @@index([knockId])
  @@index([clientKnockId])
  @@index([mlProcessedAt])
}

// Neighbourhood / area propensity score. The ML team WRITES these; the platform
// READS them to colour the heatmap and inform the manager's area-setting. Keyed
// flexibly (H3 cell, address hash, lat/lng bin) so the model can evolve. orgId
// null = a shared/global model; set = org-specific.
model PropensityScore {
  id           String     @id // pps_*
  orgId        String?
  org          Org?       @relation(fields: [orgId], references: [id])
  regionCode   RegionCode
  geoType      String // "h3" | "address" | "bbox" | "latlng"
  geoKey       String // cell id / hash / bin key
  centroidLat  Float?
  centroidLng  Float?
  score        Float // 0..1 propensity to convert
  band         String? // "high" | "medium" | "low" — heatmap bucket
  modelName    String
  modelVersion String
  features     Json? // feature vector / SHAP-style explanation
  computedAt   DateTime   @default(now())

  @@index([orgId, geoType, geoKey])
  @@index([regionCode, band])
  @@index([geoType, geoKey])
}

// Door-conversation voice recording. CAPTURE SCAFFOLD ONLY — the audio is the
// future fuel for the conversation-intelligence ML pipeline (transcribe →
// sentiment / objections / outcome signals). ⚠️ LEGAL: many US states require
// ALL-PARTY consent to record. `consentObtained` MUST be true before any audio
// is captured; default-off until counsel signs off. Never enable blindly.
model VoiceRecording {
  id                  String     @id // vrc_*
  orgId               String
  org                 Org        @relation(fields: [orgId], references: [id])
  userId              String
  user                User       @relation(fields: [userId], references: [id])
  regionCode          RegionCode
  knockId             String?
  clientKnockId       String?
  storageKey          String // S3 object key
  durationMs          Int?
  capturedAt          DateTime
  consentObtained     Boolean    @default(false) // all-party consent gate (legal)
  transcriptionStatus String     @default("pending") // pending|processing|done|failed|skipped
  transcript          String? /// PII — written by the ML pipeline
  analysis            Json? // sentiment / objections / outcome (ML)
  processedAt         DateTime?
  createdAt           DateTime   @default(now())

  @@index([orgId, transcriptionStatus])
  @@index([knockId])
  @@index([processedAt])
}

// Normalised, append-only analytics event stream — the warehouse outbox. EVERY
// field action mirrors here as a flat, denormalised row so the data team can
// export to a warehouse (BigQuery / Snowflake) + dbt without touching OLTP.
// `shippedAt` is set by the export job. This is the "plug in data scientists"
// backbone.
model AnalyticsEvent {
  id         String     @id // aev_*
  orgId      String
  org        Org        @relation(fields: [orgId], references: [id])
  regionCode RegionCode
  userId     String?
  eventType  String // "knock" | "sale" | "session_start" | "session_end" | "photo" | "lead" | …
  entityType String?
  entityId   String?
  occurredAt DateTime
  payload    Json // flat analytical payload (geo, disposition, amountCents, …)
  shippedAt  DateTime? // set when exported to the warehouse
  createdAt  DateTime   @default(now())

  @@index([orgId, eventType, occurredAt])
  @@index([shippedAt])
  @@index([eventType, occurredAt])
}
