{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "main": "dist/src/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "worker:audit": "tsx src/workers/audit-shipper.worker.ts",
    "worker:knock-sync": "tsx src/workers/knock-sync.worker.ts",
    "worker:lead-routing": "tsx src/workers/lead-routing.worker.ts",
    "worker:conversion-finalise": "tsx src/workers/conversion-finalise.worker.ts",
    "worker:commission-calc": "tsx src/workers/commission-calc.worker.ts",
    "worker:payout-prepare": "tsx src/workers/payout-prepare.worker.ts",
    "worker:webhook-deliver": "tsx src/workers/webhook-deliver.worker.ts",
    "worker:content-generate": "tsx src/workers/content-generate.worker.ts",
    "worker:ad-deliver": "tsx src/workers/ad-deliver.worker.ts",
    "worker:dnk-sync": "tsx src/workers/dnk-sync.worker.ts",
    "worker:geo-refresh": "tsx src/workers/geo-refresh.worker.ts",
    "audit:verify": "tsx src/scripts/audit-chain-verify.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-kms": "^3.654.0",
    "@aws-sdk/client-s3": "^3.654.0",
    "@aws-sdk/client-secrets-manager": "^3.654.0",
    "@d2d/integrations": "workspace:*",
    "@d2d/shared-types": "workspace:*",
    "@d2d/shared-utils": "workspace:*",
    "@fastify/cookie": "^9.4.0",
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/sensible": "^5.6.0",
    "@fastify/websocket": "^10.0.1",
    "@node-saml/node-saml": "^5.1.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.51.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.54.0",
    "@opentelemetry/resources": "^1.27.0",
    "@opentelemetry/sdk-node": "^0.54.0",
    "@opentelemetry/semantic-conventions": "^1.27.0",
    "@prisma/client": "^5.22.0",
    "argon2": "^0.41.1",
    "bullmq": "^5.21.2",
    "fastify": "^4.28.1",
    "ioredis": "^5.4.1",
    "otplib": "^12.0.1",
    "pino": "^9.4.0",
    "pino-pretty": "^11.2.2",
    "ulid": "^2.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitest/coverage-v8": "^2.1.1",
    "eslint": "^8.57.0",
    "prisma": "^5.20.0",
    "supertest": "^7.0.0",
