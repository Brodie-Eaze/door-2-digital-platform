<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Knocker iOS</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>D2D_API_BASE_URL</key>
	<!-- DEMO: points DEBUG builds (sim + physical device on the same Wi-Fi) at the
	     Mac's LAN IP so a real iPhone can reach the local API. Find your current IP
	     with `ipconfig getifaddr en0` and update the host if it changes. RELEASE
	     builds ignore this and use the production https URL fallback in Config. -->
	<string>http://192.168.20.41:3010/v1</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- DEBUG: allows plaintext HTTP to any host so the simulator can reach
		     the Fastify API on the Mac's LAN IP (192.168.x.x). ATS is re-enabled
		     for production releases via scheme-conditional build settings. -->
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSCameraUsageDescription</key>
	<string>D2D Knocker uses the camera to photograph addresses and capture evidence during knock visits.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>Use Face ID to re-authenticate and protect your field data.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>D2D Knocker requires your location to accurately record knock coordinates and track field coverage during your shift.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>D2D Knocker uses your location to record where knocks occur.</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict/>
	</dict>
	<key>UIBackgroundModes</key>
	<array>
		<string>location</string>
		<string>fetch</string>
	</array>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
