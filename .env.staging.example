# =============================================================================
# Door 2 Digital — STAGING environment template
# =============================================================================
# Copy per service into the Railway dashboard (Variables tab) or pipe via
#   railway variables --set KEY=VALUE --service <svc>
#
# This file is committed as an EXAMPLE ONLY. It contains NO real secrets —
# every value is an UPPERCASE _PLACEHOLDER token. gitleaks runs on commit; keep
# it that way. Never copy real staging secrets back into this file.
#
# Variable names are derived from the live schema, not guessed:
#   - API:  apps/api/src/config/env.ts  (Zod, fail-fast at boot)
#   - WEB:  apps/web-operator/src  (server-side route handlers + @d2d/database SSR)
#
# Generate all secrets at once (paste into a shell, then copy into Railway):
#   openssl rand -hex 32      -> 64 hex chars  (PII_ENCRYPTION_KEY, KMS_DEV_SECRET,
#                                               all *_SECRET, PII_HASH_SECRET,
#                                               PII_SEARCH_KEY, AUDIT_CHAIN_SECRET)
#   openssl rand -base64 32   -> ~44 chars     (PII_KMS_KEY, PII_SIV_KEY)
#
# NOTE on the old docs/RAILWAY-ENV.md: it lists JWT_SECRET / WEBHOOK_SECRET_PEPPER
# / AUDIT_HASH_PEPPER — those names are STALE and do NOT match env.ts. Use the
# names in THIS file. See docs/STAGING-DEPLOY.md for the reconciliation note.
#
# Length/format rules enforced by env.ts at API boot (server crashes if wrong):
#   PII_ENCRYPTION_KEY  exactly 64 chars (32 bytes hex)
#   KMS_DEV_SECRET      exactly 64 chars (optional)
#   PII_KMS_KEY         >= 40 chars   (base64 of 32 bytes ~= 44)
#   PII_SIV_KEY         >= 40 chars   (base64 of 32 bytes ~= 44)
#   all *_SECRET / PII_HASH_SECRET / PII_SEARCH_KEY  >= 32 chars
# =============================================================================


# #############################################################################
# SERVICE: d2d-api-staging  (Fastify)
# #############################################################################

# --- Runtime ----------------------------------------------------------------
NODE_ENV=production
LOG_LEVEL=info
AWS_REGION=us-east-1
# PORT — DO NOT SET. Railway injects it. App default is 3010 (port contract).
# HOST defaults to 0.0.0.0 in env.ts; leave unset.

# --- CORS (REQUIRED in production — API fail-fasts if only localhost) --------
# Must be the real staging web-operator origin(s), comma-separated, https.
# Railway reference form (preferred): use ${{ ... }} in the dashboard, e.g.
#   CORS_ORIGINS = https://${{ d2d-web-operator-staging.RAILWAY_PUBLIC_DOMAIN }}
CORS_ORIGINS=PLACEHOLDER_STAGING_WEB_OPERATOR_HTTPS_ORIGIN

# --- Public origin of THIS API (callbacks, SAML SP, Planet webhook) ---------
# Railway reference form:  https://${{ RAILWAY_PUBLIC_DOMAIN }}
API_BASE_URL=PLACEHOLDER_STAGING_API_HTTPS_ORIGIN
SAML_SP_BASE_URL=PLACEHOLDER_STAGING_API_HTTPS_ORIGIN

# --- Core: Database + Redis (REQUIRED) --------------------------------------
# From the Railway managed plugins via reference variables (preferred):
#   DATABASE_URL = ${{ Postgres.DATABASE_URL }}
#   REDIS_URL    = ${{ Redis.REDIS_URL }}
# NOTE: Postgres must have the PostGIS extension. Railway's vanilla PG plugin
# does NOT ship it — enable it (see docs/STAGING-DEPLOY.md) before migrate.
DATABASE_URL=PLACEHOLDER_FROM_RAILWAY_POSTGRES_PLUGIN
DATABASE_REPLICA_URL=
REDIS_URL=PLACEHOLDER_FROM_RAILWAY_REDIS_PLUGIN

# --- Core: Encryption / PII (REQUIRED) --------------------------------------
PII_ENCRYPTION_KEY=PLACEHOLDER_GENERATE_64_HEX_CHARS
PII_HASH_SECRET=PLACEHOLDER_GENERATE_MIN_32_CHARS
PII_SEARCH_KEY=PLACEHOLDER_GENERATE_MIN_32_CHARS
AUDIT_CHAIN_SECRET=PLACEHOLDER_GENERATE_MIN_32_CHARS
PII_KMS_KEY=PLACEHOLDER_GENERATE_BASE64_MIN_40_CHARS
PII_SIV_KEY=PLACEHOLDER_GENERATE_BASE64_MIN_40_CHARS
# Dev/staging "KMS" wrapping key. Optional; set when not using real AWS KMS.
KMS_DEV_SECRET=PLACEHOLDER_GENERATE_64_HEX_CHARS
# OPTIONAL — needs real AWS for prod; leave blank in staging:
AWS_KMS_KEY_ARN=

# --- Core: Auth secrets (REQUIRED) ------------------------------------------
JWT_ACCESS_SECRET=PLACEHOLDER_GENERATE_MIN_32_CHARS
JWT_REFRESH_SECRET=PLACEHOLDER_GENERATE_MIN_32_CHARS
JWT_WS_TICKET_SECRET=PLACEHOLDER_GENERATE_MIN_32_CHARS
CSRF_SIGNING_SECRET=PLACEHOLDER_GENERATE_MIN_32_CHARS
OAUTH_STATE_SECRET=PLACEHOLDER_GENERATE_MIN_32_CHARS
MFA_STEP_UP_SECRET=PLACEHOLDER_GENERATE_MIN_32_CHARS
API_TOKEN_HASH_SECRET=PLACEHOLDER_GENERATE_MIN_32_CHARS
# WebAuthn — set RP_ID to the staging web host (no scheme), ORIGIN to its URL:
WEBAUTHN_RP_ID=PLACEHOLDER_STAGING_WEB_OPERATOR_HOST
WEBAUTHN_ORIGIN=PLACEHOLDER_STAGING_WEB_OPERATOR_HTTPS_ORIGIN

# --- Core: Object storage (REQUIRED strings — buckets must exist) -----------
# env.ts requires these three to be present (non-empty). Point at staging buckets.
S3_BUCKET_AUDIT=PLACEHOLDER_d2d_audit_us_east_1_staging
S3_BUCKET_ASSETS=PLACEHOLDER_d2d_assets_us_east_1_staging
S3_BUCKET_EXPORTS=PLACEHOLDER_d2d_exports_us_east_1_staging

# --- Payment sandbox toggle (staging convenience, NEVER enabled in prod) ----
# Set the literal string  true  to expose POST /v1/payments/tokenize in staging.
D2D_PAYMENT_SANDBOX=true

# --- Workers / cron leadership (only on the worker replica, if deployed) ----
# Set the literal string  true  on exactly one worker replica per region.
CRON_LEADER=false

# =============================================================================
# OPTIONAL FOR STAGING — needs real credentials before PROD.
# Leave blank in staging unless you are specifically exercising that integration.
# All of these are .optional() in env.ts; the API boots fine without them.
# =============================================================================

# --- Enterprise SSO (Pilot-Charlie) — OPTIONAL ------------------------------
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_REGION=us-east-1
OKTA_SAML_METADATA_URL=

# --- Payments: MiCamp (US, Brodie's ISO) — OPTIONAL / needs prod creds ------
MICAMP_API_KEY=
MICAMP_API_SECRET=
MICAMP_GATEWAY_URL=
MICAMP_WEBHOOK_SECRET=
MICAMP_ISO_AGENT_ID=

# --- Payments: Stripe (AU, SG) — OPTIONAL / needs prod creds ----------------
STRIPE_AU_SECRET_KEY=
STRIPE_AU_WEBHOOK_SECRET=
STRIPE_SG_SECRET_KEY=
STRIPE_SG_WEBHOOK_SECRET=

# --- Comms (Twilio, Resend) — OPTIONAL --------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_US_MESSAGING_SID=
RESEND_API_KEY=

# --- Mapping / Realtime — OPTIONAL ------------------------------------------
MAPBOX_TOKEN=
ABLY_API_KEY=

# --- AI providers — OPTIONAL ------------------------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
REPLICATE_API_TOKEN=
RUNWAY_API_KEY=

# --- Data intelligence: Snowflake — OPTIONAL / needs prod creds -------------
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USERNAME=
SNOWFLAKE_PASSWORD=

# --- Data intelligence: Planet Labs satellite — OPTIONAL / needs prod creds -
PLANET_API_KEY=
PLANET_WEBHOOK_SECRET=

# --- Observability — OPTIONAL (recommended in staging) ----------------------
SENTRY_DSN=
DATADOG_API_KEY=
OTEL_EXPORTER_OTLP_ENDPOINT=
PAGERDUTY_INTEGRATION_KEY=


# #############################################################################
# SERVICE: d2d-web-operator-staging  (Next.js standalone)
# #############################################################################
#
# This console does BOTH: (a) renders pages server-side directly against
# Postgres via @d2d/database, and (b) proxies marketing/auth calls to the API.
# So it needs DATABASE_URL + a few shared secrets at RUNTIME, plus the
# NEXT_PUBLIC_* values at BUILD time.

# --- BUILD-TIME (burned into the bundle — set as Railway *build* variables) --
# Must point at the staging API public URL BEFORE the image is built.
# Changing these requires a REBUILD, not just a redeploy.
#   NEXT_PUBLIC_API_URL = https://${{ d2d-api-staging.RAILWAY_PUBLIC_DOMAIN }}
#   NEXT_PUBLIC_WS_URL  = wss://${{ d2d-api-staging.RAILWAY_PUBLIC_DOMAIN }}
NEXT_PUBLIC_API_URL=PLACEHOLDER_STAGING_API_HTTPS_ORIGIN
NEXT_PUBLIC_WS_URL=PLACEHOLDER_STAGING_API_WSS_ORIGIN
NEXT_PUBLIC_ENV=staging

# --- RUNTIME ----------------------------------------------------------------
NODE_ENV=production
# PORT — DO NOT SET. Railway injects it. Default is 3000 (port contract).
# HOSTNAME defaults to 0.0.0.0 in the Dockerfile; leave unset.

# Server-side SSR connects to Postgres directly (same DB as the API):
#   DATABASE_URL = ${{ Postgres.DATABASE_URL }}
DATABASE_URL=PLACEHOLDER_FROM_RAILWAY_POSTGRES_PLUGIN

# Shared secrets — MUST match the API service exactly (session verify + audit
# hash chain + blind-index search must agree across both services):
JWT_ACCESS_SECRET=PLACEHOLDER_SAME_VALUE_AS_API
SESSION_COOKIE_SECRET=PLACEHOLDER_SAME_AS_API_FALLBACK_FOR_JWT_ACCESS_SECRET
AUDIT_CHAIN_SECRET=PLACEHOLDER_SAME_VALUE_AS_API
PII_SEARCH_KEY=PLACEHOLDER_SAME_VALUE_AS_API

# Demo accommodation: literal  true  ONLY for a standalone no-API demo build.
# Leave blank for a real staging deploy that talks to the API.
DEMO_MODE_ENABLED=
