# =============================================================================
# Door 2 Digital — environment variables example.
# Copy to .env.local for dev. Production secrets live in AWS Secrets Manager.
# =============================================================================

# --- Runtime ----------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=debug
AWS_REGION=us-east-1

# --- Database ---------------------------------------------------------------
DATABASE_URL=postgresql://d2d:d2d@localhost:5433/d2d_dev?schema=public
DATABASE_REPLICA_URL=
DATABASE_LONG_URL=
REDIS_URL=redis://localhost:6380

# --- Encryption / PII --------------------------------------------------------
# Generate locally: openssl rand -hex 32
KMS_DEV_SECRET=REPLACE_ME_32_BYTES_HEX
AWS_KMS_KEY_ARN=
PII_ENCRYPTION_KEY=REPLACE_ME_32_BYTES_HEX
PII_HASH_SECRET=REPLACE_ME_32_BYTES_HEX
PII_SEARCH_KEY=REPLACE_ME_32_BYTES_HEX
AUDIT_CHAIN_SECRET=REPLACE_ME_32_BYTES_HEX

# --- Auth -------------------------------------------------------------------
JWT_ACCESS_SECRET=REPLACE_ME_32_BYTES_HEX
JWT_REFRESH_SECRET=REPLACE_ME_32_BYTES_HEX
JWT_WS_TICKET_SECRET=REPLACE_ME_32_BYTES_HEX
CSRF_SIGNING_SECRET=REPLACE_ME_32_BYTES_HEX
OAUTH_STATE_SECRET=REPLACE_ME_32_BYTES_HEX
MFA_STEP_UP_SECRET=REPLACE_ME_32_BYTES_HEX
API_TOKEN_HASH_SECRET=REPLACE_ME_32_BYTES_HEX

WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:3011

COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_REGION=us-east-1

# Enterprise SSO (Pilot-Charlie)
OKTA_SAML_METADATA_URL=

# --- Payments: MiCamp (US) — Brodie's ISO ----------------------------------
MICAMP_API_KEY=
MICAMP_API_SECRET=
MICAMP_GATEWAY_URL=https://gateway.micamp.com
MICAMP_WEBHOOK_SECRET=
MICAMP_ISO_AGENT_ID=

# --- Payments: Stripe (AU, SG — Phase 2/3) ---------------------------------
STRIPE_AU_SECRET_KEY=
STRIPE_AU_WEBHOOK_SECRET=
STRIPE_SG_SECRET_KEY=
STRIPE_SG_WEBHOOK_SECRET=

# --- Comms ------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_US_MESSAGING_SID=
TWILIO_AU_MESSAGING_SID=
TWILIO_SG_MESSAGING_SID=
RESEND_API_KEY=

# --- Mapping ----------------------------------------------------------------
MAPBOX_TOKEN=
MAPBOX_PUBLIC_TOKEN=pk_example_public_token

# --- Realtime ---------------------------------------------------------------
ABLY_API_KEY=
ABLY_PUBLIC_KEY=

# --- AI providers -----------------------------------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
REPLICATE_API_TOKEN=
RUNWAY_API_KEY=
HEYGEN_API_KEY=

# --- Ad delivery -----------------------------------------------------------
META_MARKETING_APP_ID=
META_MARKETING_APP_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
TIKTOK_MARKETING_APP_ID=
TIKTOK_MARKETING_APP_SECRET=

# --- Object storage --------------------------------------------------------
S3_BUCKET_AUDIT=d2d-audit-us-east-1-dev
S3_BUCKET_ASSETS=d2d-assets-us-east-1-dev
S3_BUCKET_EXPORTS=d2d-exports-us-east-1-dev

# --- Observability ----------------------------------------------------------
SENTRY_DSN=
DATADOG_API_KEY=
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
PAGERDUTY_INTEGRATION_KEY=

# --- App URLs (NEXT_PUBLIC_*) ----------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:3010
NEXT_PUBLIC_WS_URL=ws://localhost:3010
NEXT_PUBLIC_ENV=local
