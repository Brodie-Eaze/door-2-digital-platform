{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [".env", "tsconfig.base.json"],
  "globalPassThroughEnv": [
    "DATABASE_URL",
    "DATABASE_REPLICA_URL",
    "DATABASE_LONG_URL",
    "REDIS_URL",
    "NODE_ENV",
    "LOG_LEVEL",
    "AWS_REGION",
    "AWS_ACCESS_KEY_ID",
    "AWS_SECRET_ACCESS_KEY",
    "AWS_KMS_KEY_ARN",
    "KMS_DEV_SECRET",
    "PII_ENCRYPTION_KEY",
    "PII_HASH_SECRET",
    "PII_SEARCH_KEY",
    "AUDIT_CHAIN_SECRET",
    "JWT_ACCESS_SECRET",
    "JWT_REFRESH_SECRET",
    "JWT_WS_TICKET_SECRET",
    "CSRF_SIGNING_SECRET",
    "OAUTH_STATE_SECRET",
    "MFA_STEP_UP_SECRET",
    "METRICS_BEARER_TOKEN",
    "API_TOKEN_HASH_SECRET",
    "WEBAUTHN_RP_ID",
    "WEBAUTHN_ORIGIN",
    "COGNITO_USER_POOL_ID",
    "COGNITO_CLIENT_ID",
    "COGNITO_REGION",
    "OKTA_SAML_METADATA_URL",
    "MICAMP_API_KEY",
    "MICAMP_API_SECRET",
    "MICAMP_GATEWAY_URL",
    "MICAMP_WEBHOOK_SECRET",
    "MICAMP_ISO_AGENT_ID",
    "STRIPE_AU_SECRET_KEY",
    "STRIPE_AU_WEBHOOK_SECRET",
    "STRIPE_SG_SECRET_KEY",
    "STRIPE_SG_WEBHOOK_SECRET",
    "TWILIO_ACCOUNT_SID",
    "TWILIO_AUTH_TOKEN",
    "TWILIO_US_MESSAGING_SID",
    "TWILIO_AU_MESSAGING_SID",
    "TWILIO_SG_MESSAGING_SID",
    "RESEND_API_KEY",
    "MAPBOX_TOKEN",
    "MAPBOX_PUBLIC_TOKEN",
    "ABLY_API_KEY",
    "ABLY_PUBLIC_KEY",
    "ANTHROPIC_API_KEY",
    "OPENAI_API_KEY",
    "REPLICATE_API_TOKEN",
    "RUNWAY_API_KEY",
    "HEYGEN_API_KEY",
    "META_MARKETING_APP_ID",
    "META_MARKETING_APP_SECRET",
    "GOOGLE_ADS_DEVELOPER_TOKEN",
    "TIKTOK_MARKETING_APP_ID",
    "TIKTOK_MARKETING_APP_SECRET",
    "S3_BUCKET_AUDIT",
    "S3_BUCKET_ASSETS",
    "S3_BUCKET_EXPORTS",
    "SENTRY_DSN",
    "DATADOG_API_KEY",
    "OTEL_EXPORTER_OTLP_ENDPOINT",
    "PAGERDUTY_INTEGRATION_KEY"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build", "db:generate"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "typecheck": {
      "dependsOn": ["^build", "db:generate"],
      "outputs": []
    },
    "lint": { "outputs": [] },
    "test": {
      "dependsOn": ["^build", "db:generate"],
      "outputs": ["coverage/**"]
    },
    "test:e2e": {
      "dependsOn": ["build"],
      "outputs": ["playwright-report/**", "test-results/**"]
    },
    "db:generate": {
      "inputs": ["prisma/schema.prisma"],
      "outputs": ["node_modules/.prisma/**"]
    },
    "dev": { "cache": false, "persistent": true }
  }
}
