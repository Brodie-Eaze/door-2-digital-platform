# syntax=docker/dockerfile:1.7
#
# Door 2 Digital — public-site (Next.js 14 standalone marketing front door).
# Per-app Dockerfile pattern (mirrors Dockerfile.web-operator). Zero PII,
# zero money-path: this surface is the public marketing + contact intake only.

ARG NODE_VERSION=20.10.0

FROM node:${NODE_VERSION}-alpine AS deps
RUN apk add --no-cache libc6-compat
WORKDIR /repo
RUN corepack enable && corepack prepare pnpm@9.12.0 --activate

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json tsconfig.base.json ./
COPY apps/public-site/package.json apps/public-site/
COPY packages/shared-types/package.json packages/shared-types/
COPY packages/shared-utils/package.json packages/shared-utils/
COPY packages/ui-tokens/package.json packages/ui-tokens/
COPY packages/ui-web/package.json packages/ui-web/
COPY packages/api-client/package.json packages/api-client/
COPY packages/database/package.json packages/database/
COPY packages/integrations/package.json packages/integrations/
RUN pnpm fetch --frozen-lockfile
RUN pnpm install --frozen-lockfile --offline

FROM deps AS build
WORKDIR /repo
COPY apps/public-site ./apps/public-site
COPY packages ./packages
ARG NEXT_PUBLIC_ENV=production
ENV NEXT_PUBLIC_ENV=${NEXT_PUBLIC_ENV}
ENV NEXT_TELEMETRY_DISABLED=1
RUN pnpm --filter public-site build

FROM node:${NODE_VERSION}-alpine AS runner
RUN apk add --no-cache libc6-compat tini
WORKDIR /repo
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3015
ENV HOSTNAME=0.0.0.0

COPY --from=build /repo/apps/public-site/public ./apps/public-site/public
COPY --from=build /repo/apps/public-site/.next/standalone ./
COPY --from=build /repo/apps/public-site/.next/static ./apps/public-site/.next/static

USER node
EXPOSE 3015

ENTRYPOINT ["/sbin/tini", "--"]
CMD ["node", "apps/public-site/server.js"]
